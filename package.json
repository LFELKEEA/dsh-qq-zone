{
  "name": "dsh-qq-zone",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "QQ 空间说说 + 识图：给 DSH 里的 QQ 机器人补上两条能力——发/看/删/赞/评论说说，以及把图片交给视觉模型（本地网关）或 Windows OCR 读懂。",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "author": "LFELKEEA",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "qq",
    "qzone",
    "onebot",
    "vision"
  ],
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml"
      ]
    }
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\""
  },
  "engines": {
    "dsh": ">=0.2.0-rc.1 <0.3.0 || >=0.2.1-rc.1 <0.3.0"
  }
}